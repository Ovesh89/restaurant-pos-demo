# ==============================================================================
# Restaurant POS MERN — Production Environment Configuration (.env)
# Copy this file to .env on the deployment server: cp .env.example .env
# NEVER commit the real .env file or credentials to Git!
# ==============================================================================

# Node Environment
NODE_ENV=production

# Backend Service Port (Internal to Docker network; default: 8001)
PORT=8001

# Public Web Entry Port on Host (Nginx; default: 80)
HTTP_PORT=80

# MongoDB Atlas Connection URI
# Example: mongodb+srv://pos_user:YourStrongPassword@pos-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Active MongoDB Database Name
MONGODB_DATABASE=restaurant_pos_demo

# JWT Secret Key (generate with: openssl rand -hex 32)
# Must be at least 32-64 characters in production
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# JWT Expiration Settings
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS Allowed Origins (Comma-separated URLs permitted to access API directly)
# Include your domain and local IPs if necessary
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Logging verbosity (error, warn, info, debug)
LOG_LEVEL=info
