# Server Configuration
NODE_ENV=development
PORT=8001
SECRET_KEY=pos-mern-dev-secret-key-change-in-production

# MongoDB Configuration (Isolated from legacy restaurant_pos_dev)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=restaurant_pos_mern_dev
MONGODB_TEST_DATABASE=restaurant_pos_mern_test

# JWT Settings (Compatible with Django HS256 token contract)
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# Logging
LOG_LEVEL=info
